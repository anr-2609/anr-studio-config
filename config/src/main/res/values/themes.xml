<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="ThemeAnrStudioConfig" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/color_bg_main</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:colorBackground">@color/color_bg_main</item>
        <item name="backgroundColor">@color/color_bg_main</item>
        <item name="colorPrimary">@color/color_main</item>
        <item name="colorAccent">@color/color_main</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/color_9E9E9E</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/color_bg_main</item>
        <item name="android:navigationBarColor">@color/white</item>
    </style>

    <style name="AnrStudioConfigDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="backgroundColor">@color/white</item>
        <item name="colorPrimary">@color/color_main</item>
        <item name="colorAccent">@color/color_main</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/color_9E9E9E</item>
    </style>
</resources>
